# Example nginx TLS termination for HandForge companion.
# Replace companion.example.com and certificate paths; upstream = local serve.

server {
    listen 443 ssl http2;
    server_name companion.example.com;

    ssl_certificate     /etc/letsencrypt/live/companion.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/companion.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE (GET /api/events) needs long-lived connections
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
